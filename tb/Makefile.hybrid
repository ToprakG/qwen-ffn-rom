SIM ?= verilator
TOPLEVEL_LANG ?= verilog

PWD := $(shell pwd)
ROOT := $(abspath $(PWD)/..)

VERILOG_SOURCES += $(ROOT)/rtl/gated_delta_step.v
VERILOG_SOURCES += $(ROOT)/rtl/ffn_tile_8x8_b4_reg.v
VERILOG_SOURCES += $(ROOT)/rtl/hybrid_layer_stub.v
TOPLEVEL := hybrid_layer_stub
COCOTB_TEST_MODULES := test_hybrid
SIM_BUILD := sim_build_hybrid

ifeq ($(SIM),verilator)
EXTRA_ARGS += --timescale 1ns/1ps -Wno-fatal -Wno-WIDTH -Wno-SELRANGE
endif

include $(shell cocotb-config --makefiles)/Makefile.sim
