SIM ?= verilator
TOPLEVEL_LANG ?= verilog

PWD := $(shell pwd)
ROOT := $(abspath $(PWD)/..)

export DELTA_D := 4
export DELTA_MAC := 4
export DELTA_LAYERS := 24
export DELTA_EQUIV := qwen08b_farm_d4_equiv.json
export DELTA_DUT := rtl/qwen08b_farm_d4.v

VERILOG_SOURCES += $(ROOT)/rtl/delta_s_col_ram.v
VERILOG_SOURCES += $(ROOT)/rtl/gated_delta_bram.v
VERILOG_SOURCES += $(ROOT)/rtl/qwen08b_delta_farm.v
VERILOG_SOURCES += $(ROOT)/rtl/qwen08b_farm_d4.v
TOPLEVEL := qwen08b_farm_d4
COCOTB_TEST_MODULES := test_gated_delta
SIM_BUILD := sim_build_farm_d4

ifeq ($(SIM),verilator)
EXTRA_ARGS += --timescale 1ns/1ps -Wno-fatal -Wno-WIDTH -Wno-SELRANGE
endif

include $(shell cocotb-config --makefiles)/Makefile.sim
